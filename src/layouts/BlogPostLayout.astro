---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Calvin Stahoviak`} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-20">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-3 mb-4 font-mono text-sm" style={`color: var(--color-text-secondary)`}>
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags && tags.length > 0 && (
          <>
            <span style={`color: var(--color-border)`}>|</span>
            <div class="flex gap-2 flex-wrap">
              {tags.map((tag) => (
                <span
                  class="px-2 py-0.5 text-xs rounded"
                  style={`background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-accent-blue)`}
                >
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
      <h1 class="text-4xl md:text-5xl font-mono font-bold tracking-tight mb-4" style={`color: var(--color-text)`}>
        {title}
      </h1>
      <p class="text-lg" style={`color: var(--color-text-secondary)`}>{description}</p>
      <div class="mt-8 h-px" style={`background: var(--color-border)`}></div>
    </header>

    <!-- Content -->
    <div class="prose">
      <slot />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8" style={`border-top: 1px solid var(--color-border)`}>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 font-mono text-sm transition-colors"
        style={`color: var(--color-text-secondary)`}
        onmouseover="this.style.color='var(--color-accent-blue)'"
        onmouseout="this.style.color='var(--color-text-secondary)'"
      >
        <span>&larr;</span> Back to all posts
      </a>
    </div>
  </article>
</BaseLayout>
