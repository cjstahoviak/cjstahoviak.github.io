---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { publications } from '../data/publications';
---

<BaseLayout title="Publications — Calvin Stahoviak" description="Academic publications by Calvin Stahoviak in robotics, computer vision, and machine learning.">
  <section class="max-w-6xl mx-auto px-6 pt-28 pb-20">
    <!-- Page header -->
    <div class="mb-16">
      <h1 class="text-4xl md:text-5xl font-mono font-bold tracking-tight mb-4" style={`color: var(--color-text)`}>
        Publications
      </h1>
      <p class="text-base max-w-xl" style={`color: var(--color-text-secondary)`}>
        Peer-reviewed papers in robotics, computer vision, and intelligent systems.
      </p>
      <div class="h-1 w-16 rounded mt-4" style={`background: var(--color-accent-coral)`}></div>
    </div>

    <!-- Publications list (data lives in src/data/publications.ts) -->
    <div class="max-w-3xl">
      {publications.map((pub, i) => (
        <TimelineItem index={i} total={publications.length}>
          <PublicationEntry publication={pub} index={i + 1} />
        </TimelineItem>
      ))}
    </div>
  </section>
</BaseLayout>
