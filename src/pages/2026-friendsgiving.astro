---
// Potluck sign-up for Friendsgiving 2026. Deliberately standalone: no
// BaseLayout, no site theme, not linked from anywhere, not indexed.
//
// GitHub Pages can't store data, so the list lives in a Google Sheet and is
// read and written through an Apps Script web app (apps-script/
// friendsgiving.gs). This is that deployment's /exec URL.
const SHEET_API =
  'https://script.google.com/macros/s/AKfycby0W84B-2GTEiPwcnUrE3fkus0iU1HiUB55wq5sqJV6dJda6eGp3yvuK-UNWRWmWVhJ/exec';

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#96602f" />
    <meta name="robots" content="noindex" />
    <title>2026 Friendsgiving</title>
    <meta name="description" content="Who's bringing what." />
    <meta property="og:title" content="2026 Friendsgiving" />
    <meta property="og:description" content="Who's bringing what." />
    <link rel="icon" href="/friendsgiving/turkey.gif" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chewy&display=swap"
    />
  </head>
  <body>
    <div class="turkeys"></div>
    <canvas id="leaves" aria-hidden="true"></canvas>

    <main data-api={SHEET_API}>
      <h1>2026 Friendsgiving</h1>
      <img
        class="mascot"
        src="/friendsgiving/turkey.gif"
        width="355"
        height="261"
        alt="A hand-drawn turkey wearing a top hat"
      />

      <table>
        <thead>
          <tr><th scope="col">Name</th><th scope="col">Dish</th></tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      <p id="status" role="status">Loading…</p>
    </main>

    <style is:inline>
      :root {
        --brown: #96602f;
        --ink: #2b1a0c;
        --line: #c7b299;
        --tile: 180px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        overflow-x: hidden;
        background: var(--brown);
        color: var(--ink);
        font-family: system-ui, sans-serif;
        font-size: 1rem;
        line-height: 1.4;
      }

      /* Oversized by one tile on every side, so sliding it exactly one
         tile down and to the left loops without showing an edge. The tile
         is built at 2x by hand from a turkey icon (rotated and skewed). */
      .turkeys {
        position: fixed;
        inset: calc(-1 * var(--tile));
        background-image: url('/friendsgiving/turkey-tile.png');
        background-size: var(--tile) var(--tile);
        animation: drift 24s linear infinite;
      }

      @keyframes drift {
        to {
          transform: translate(calc(-1 * var(--tile)), var(--tile));
        }
      }

      #leaves {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      main {
        position: relative;
        width: min(100%, 34rem);
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
      }

      h1 {
        margin: 0;
        font-family: 'Chewy', system-ui, sans-serif;
        font-weight: 400;
        font-size: clamp(2.2rem, 10vw, 3.5rem);
        line-height: 1;
        text-align: center;
        color: #fff4dc;
        text-shadow: 0.06em 0.06em 0 var(--ink);
      }

      .mascot {
        display: block;
        width: min(50%, 12rem);
        height: auto;
        margin: 0.5rem auto;
        image-rendering: pixelated;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        background: #fffdf8;
      }

      th,
      td {
        border: 1px solid var(--line);
      }

      th {
        padding: 0.45rem 0.6rem;
        background: #efe3d0;
        font-size: 0.85rem;
        font-weight: 600;
        text-align: left;
      }

      th:first-child {
        width: 36%;
      }

      td {
        padding: 0;
      }

      /* Each cell is an input, like a spreadsheet. 16px keeps iOS from
         zooming in on focus. */
      input {
        display: block;
        width: 100%;
        padding: 0.55rem 0.6rem;
        font: inherit;
        font-size: 16px;
        color: inherit;
        background: none;
        border: 0;
        border-radius: 0;
        text-overflow: ellipsis;
      }

      input::placeholder {
        color: #a8977f;
      }

      input:focus {
        outline: 2px solid #c8641a;
        outline-offset: -2px;
      }

      #status {
        min-height: 1.4em;
        margin: 0.4rem 0 0;
        font-size: 0.85rem;
        text-align: right;
        color: #fff4dc;
      }
    </style>

    <script>
      // ---- Falling pixel leaves -------------------------------------
      const SPRITES = [
        [
          '....#....',
          '.#.###.#.',
          '.###o###.',
          '####o####',
          '.##ooo##.',
          '..##o##..',
          '.#.#o#.#.',
          '....o....',
          '....o....',
        ],
        [
          '...#...',
          '..###..',
          '.##o##.',
          '.##o##.',
          '###o###',
          '.##o##.',
          '.##o##.',
          '..#o#..',
          '...o...',
        ],
        ['..##.', '.###o', '###o.', '##o..', '.o...'],
      ];
      // [leaf colour, vein colour]
      const PALETTE = [
        ['#e8751a', '#a84d0b'],
        ['#f2b632', '#b9811a'],
        ['#c8372d', '#84201a'],
        ['#d99a2b', '#96651a'],
        ['#a5461d', '#6b2a0e'],
      ];

      interface Leaf {
        sprite: string[];
        colors: string[];
        px: number;
        x: number;
        y: number;
        speed: number;
        sway: number;
        phase: number;
        flip: boolean;
      }

      function initLeaves() {
        const canvas = document.getElementById('leaves');
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const ctx = canvas.getContext('2d')!;
        const pick = <T,>(list: T[]) =>
          list[Math.floor(Math.random() * list.length)];
        let leaves: Leaf[] = [];

        function spawn(anywhere: boolean): Leaf {
          const px = pick([3, 3, 4, 5]);
          return {
            sprite: pick(SPRITES),
            colors: pick(PALETTE),
            px,
            x: Math.random() * (canvas.width + 200),
            y: anywhere ? Math.random() * canvas.height : -12 * px,
            speed: 18 + Math.random() * 30,
            sway: 12 + Math.random() * 30,
            phase: Math.random() * Math.PI * 2,
            flip: Math.random() < 0.5,
          };
        }

        function resize() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
          const count = Math.round(
            Math.min(40, Math.max(12, canvas.width / 45)),
          );
          leaves = Array.from({ length: count }, () => spawn(true));
        }

        function draw(leaf: Leaf, time: number) {
          const { sprite, colors, px } = leaf;
          const sway = Math.sin(time * 0.9 + leaf.phase) * leaf.sway;
          // Snap to the leaf's own pixel grid so it moves in chunky steps.
          const left = Math.round((leaf.x + sway) / px) * px;
          const top = Math.round(leaf.y / px) * px;
          const cols = sprite[0].length;
          for (let r = 0; r < sprite.length; r++) {
            for (let c = 0; c < cols; c++) {
              const cell = sprite[r][leaf.flip ? cols - 1 - c : c];
              if (cell === '.') continue;
              ctx.fillStyle = cell === '#' ? colors[0] : colors[1];
              ctx.fillRect(left + c * px, top + r * px, px, px);
            }
          }
        }

        let last = performance.now();
        function frame(now: number) {
          // Clamp so leaves don't teleport after the tab was in the back.
          const dt = Math.min(0.05, (now - last) / 1000);
          last = now;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          leaves.forEach((leaf, i) => {
            leaf.y += leaf.speed * dt;
            // A light breeze toward the bottom-left, matching the turkeys.
            leaf.x -= leaf.speed * 0.35 * dt;
            if (leaf.y > canvas.height + 20) leaves[i] = spawn(false);
            draw(leaf, now / 1000);
          });
          requestAnimationFrame(frame);
        }

        resize();
        window.addEventListener('resize', resize);
        requestAnimationFrame(frame);
      }

      // ---- Sign-up sheet --------------------------------------------
      // The table behaves like a two-column spreadsheet: every cell is an
      // input, a row saves when you leave it, clearing both cells of a
      // row removes it, and the blank last row adds a new one.
      interface Row {
        id: string;
        name: string;
        dish: string;
      }

      type Change =
        | { action: 'add'; name: string; dish: string }
        | { action: 'update'; id: string; name: string; dish: string }
        | { action: 'delete'; id: string };

      const POLL_MS = 10_000;

      function initSheet() {
        const api = document.querySelector('main')!.dataset.api;
        const tbody = document.getElementById('rows')!;
        const status = document.getElementById('status')!;

        let rows: Row[] = [];
        // Requests are numbered so a slow poll can't overwrite the result
        // of a newer save.
        let sent = 0;
        let applied = 0;

        function buildRow(row?: Row) {
          const tr = document.createElement('tr');
          if (row) tr.dataset.id = row.id;
          for (const key of ['name', 'dish'] as const) {
            const input = document.createElement('input');
            input.name = key;
            input.value = row ? row[key] : '';
            input.maxLength = 120;
            input.autocomplete = 'off';
            input.enterKeyHint = key === 'name' ? 'next' : 'done';
            input.ariaLabel = key === 'name' ? 'Name' : 'Dish';
            if (!row) {
              input.placeholder = key === 'name' ? 'Your name' : 'Your dish';
            }
            const td = document.createElement('td');
            td.append(input);
            tr.append(td);
          }
          return tr;
        }

        // The blank row is kept across renders so a half-typed entry
        // survives a refresh of the rows above it.
        const blank = buildRow();

        function render() {
          // Never redraw under someone who is typing; the focusout
          // handler calls this again once they leave the table.
          if (tbody.contains(document.activeElement)) return;
          tbody.replaceChildren(...rows.map(buildRow), blank);
        }

        async function request(change?: Change) {
          const seq = ++sent;
          const init: RequestInit = change
            ? {
                method: 'POST',
                // text/plain keeps this a "simple" request: no CORS
                // preflight, which Apps Script can't answer.
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(change),
              }
            : { cache: 'no-store' };
          const res = await fetch(api!, init);
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || 'Request failed');
          if (seq < applied) return;
          applied = seq;
          rows = data.rows as Row[];
          render();
        }

        async function save(change: Change) {
          status.textContent = 'Saving…';
          try {
            await request(change);
            status.textContent = '';
            return true;
          } catch {
            status.textContent = "That didn't save. Try again?";
            render();
            return false;
          }
        }

        /** Works out what leaving `tr` should save, if anything. */
        async function commit(tr: HTMLTableRowElement) {
          const [nameInput, dishInput] = tr.querySelectorAll('input');
          const name = nameInput.value.trim();
          const dish = dishInput.value.trim();
          const id = tr.dataset.id;
          if (!id) {
            if (!name || !dish) return;
            // Cleared up front so the row is free for the next entry
            // while this one saves; put back only if the save fails.
            nameInput.value = dishInput.value = '';
            const ok = await save({ action: 'add', name, dish });
            if (!ok && !nameInput.value && !dishInput.value) {
              nameInput.value = name;
              dishInput.value = dish;
            }
            return;
          }
          const saved = rows.find((row) => row.id === id);
          if (!saved) return;
          if (!name && !dish) {
            await save({ action: 'delete', id });
          } else if (
            name &&
            dish &&
            (name !== saved.name || dish !== saved.dish)
          ) {
            await save({ action: 'update', id, name, dish });
          }
          // A row with only one cell filled isn't saved; the redraw
          // below puts its last saved values back.
        }

        tbody.addEventListener('focusout', (event) => {
          const tr = (event.target as HTMLElement).closest('tr')!;
          // Moving between the two cells of one row isn't leaving it.
          if (tr.contains(event.relatedTarget as Node | null)) return;
          commit(tr);
          // Deferred so document.activeElement has already moved on.
          setTimeout(render);
        });

        tbody.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          const input = event.target as HTMLInputElement;
          const next = input.closest('tr')!.querySelectorAll('input')[1];
          if (input === next) input.blur();
          else next.focus();
        });

        async function poll() {
          if (document.hidden) return;
          try {
            await request();
            if (status.dataset.offline || status.textContent === 'Loading…') {
              status.textContent = '';
              delete status.dataset.offline;
            }
          } catch {
            status.textContent = "Can't reach the list. Retrying…";
            status.dataset.offline = 'true';
          }
        }

        if (!api) {
          status.textContent = "The sign-up sheet isn't hooked up yet.";
          return;
        }

        render();
        poll();
        setInterval(poll, POLL_MS);
        document.addEventListener('visibilitychange', poll);
      }

      initLeaves();
      initSheet();
    </script>
  </body>
</html>
