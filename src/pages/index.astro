---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypingEffect from '../components/TypingEffect.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { publications, citationSummary } from '../data/publications';

// All projects + publications for the combined carousel.
// Data lives in src/data/ — cards here use the shorter `featured`/`shortTitle`
// variants when present, since carousel cards are a fixed 350×300px.
const carouselItems = [
  ...projects.map((p) => ({
    title: p.title,
    description: p.featured?.description ?? p.description,
    skillTags: p.skillTags,
    year: p.year,
    type: 'project' as const,
    link: p.link,
    demo: p.demo,
  })),
  ...publications.map((p) => ({
    title: p.shortTitle ?? p.title,
    description: citationSummary(p),
    skillTags: p.skillTags,
    year: p.year,
    type: 'publication' as const,
    link: p.link,
    demo: undefined,
  })),
];

// Shuffle at build time
const shuffled = [...carouselItems].sort(() => Math.random() - 0.5);

// Terminal block stats. The publication counts are derived from
// src/data/publications.ts so they can never drift from the real list.
const paperCount = publications.length;
const acceptedCount = publications.filter((p) => p.status === 'accepted').length;

const terminalStats = [
  { label: 'Education', value: 'M.S. Computer Science, University of New Mexico' },
  { label: 'Thesis', value: 'Awarded distinction, Dec. 2025' },
  {
    label: 'Publications',
    value: `${paperCount} peer-reviewed ${paperCount === 1 ? 'paper' : 'papers'} (${acceptedCount} accepted)`,
  },
  { label: 'Languages', value: 'C++, CUDA, Python, MATLAB, and more' },
  { label: 'Focus', value: 'Autonomous robotics, RL, computer vision' },
];

const skills = [
  "M.S. Computer Science",
  "DOE L Clearance",
  "5+ Years Research",
  "Machine Learning",
  "Robotics",
  "Computer Vision",
];
---

<BaseLayout title="Calvin Stahoviak — Roboticist & Computer Scientist">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center overflow-hidden" id="hero-section">
    <!-- Grid background (drifts) -->
    <div class="absolute inset-0 grid-overlay pointer-events-none"></div>
    <!-- Grid mouse glow -->
    <div class="absolute inset-0 grid-glow pointer-events-none" id="grid-glow"></div>

    <!-- Blue radial glow at top -->
    <div
      class="absolute left-1/2 -translate-x-1/2 pointer-events-none"
      style="width: 900px; height: 650px; top: -200px; background: radial-gradient(ellipse at center, rgba(0,102,255,0.15), transparent 70%); z-index: 0"
    ></div>

    <div class="max-w-6xl w-full min-w-0 mx-auto px-6 py-32 relative z-10">
      <div class="max-w-3xl">
        <!-- Terminal-style label -->
        <div class="flex items-center gap-2 mb-6 animate-fade-in">
          <span
            class="inline-block w-2.5 h-2.5 rounded-full animate-pulse"
            style="background: #39FF14; box-shadow: 0 0 8px #39FF14, 0 0 16px rgba(57,255,20,0.3)"
          ></span>
          <span class="font-mono text-xs tracking-widest uppercase" style={`color: var(--color-text-secondary)`}>
            Available for opportunities
          </span>
        </div>

        <!-- Name -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-mono font-bold tracking-tighter mb-6 animate-slide-up" style={`color: var(--color-text); animation-delay: 0.4s; opacity: 0;`}>
          Calvin<br />
          <span class="text-gradient">Stahoviak</span>
        </h1>

        <!-- Typing tagline -->
        <div class="text-xl md:text-2xl font-mono mb-8 h-8 animate-slide-up" style="animation-delay: 0.9s; opacity: 0;">
          <TypingEffect
            phrases={[
              "Computer Scientist",
              "Cat Person",
              "Robotics Research Scientist",
              "Enjoys Pickup Basketball",
              "Machine Learning Engineer",
              "Competitive Online PvP Gamer",
              "Multi-Robot Systems Engineer",
              "Failed Musician",
              "Computer Vision Developer",
              "Really Bad Allergies",
            ]}
            class="text-gradient"
          /><span class="cursor-blink"></span>
        </div>

        <!-- Bio -->
        <p class="text-base md:text-lg leading-relaxed max-w-xl mb-8 animate-slide-up" style={`color: var(--color-text-secondary); animation-delay: 1.4s; opacity: 0;`}>
          M.S. in Computer Science from the University of New Mexico. I build intelligent robots
          that cooperate, perceive, and learn. Always looking for my next passion project.
        </p>

        <!-- Skills sliding window -->
        <div class="relative overflow-hidden mb-10 animate-slide-up" style="animation-delay: 1.8s; opacity: 0;">
          <!-- Fade edges -->
          <div class="absolute left-0 top-0 bottom-0 w-12 z-10 pointer-events-none" style="background: linear-gradient(to right, var(--color-bg), transparent)"></div>
          <div class="absolute right-0 top-0 bottom-0 w-12 z-10 pointer-events-none" style="background: linear-gradient(to left, var(--color-bg), transparent)"></div>

          <div class="flex gap-3" style="animation: marquee 20s linear infinite; width: max-content;">
            {[...skills, ...skills].map((skill) => (
              <span
                class="shrink-0 px-4 py-1.5 font-mono text-xs rounded-full whitespace-nowrap"
                style={`background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-secondary)`}
              >
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 animate-slide-up" style="animation-delay: 2.2s; opacity: 0;">
          <a
            href="/projects"
            class="group inline-flex items-center gap-2 px-6 py-3 font-mono text-sm font-semibold rounded-md transition-transform duration-200 ease-out-expo active-press hover:-translate-y-0.5"
            style={`background: var(--color-accent-blue); color: white`}
          >
            <span data-scramble data-scramble-trigger="parent">View Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/about"
            class="group inline-flex items-center gap-2 px-6 py-3 font-mono text-sm font-semibold rounded-md border transition-transform duration-200 ease-out-expo active-press hover:-translate-y-0.5"
            style={`border-color: var(--color-border); color: var(--color-text)`}
          >
            <span data-scramble data-scramble-trigger="parent">About Me</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in" style="animation-delay: 3s; opacity: 0;">
      <span class="font-mono text-xs" style={`color: var(--color-text-secondary)`}>scroll</span>
      <div class="w-px h-8" style={`background: var(--color-border)`}></div>
    </div>
  </section>

  <!-- Featured work carousel (projects + publications, shuffled) -->
  <section class="py-24 border-t overflow-hidden" style={`border-color: var(--color-border)`}>
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-baseline justify-between mb-12">
        <div>
          <h2 class="text-3xl font-mono font-bold tracking-tight mb-2" style={`color: var(--color-text)`}>
            Featured Work
          </h2>
          <p class="font-mono text-sm" style={`color: var(--color-text-secondary)`}>
            Selected research, engineering, and publications
          </p>
        </div>
        <a
          href="/projects"
          class="hidden sm:inline-flex items-center gap-1 font-mono text-sm transition-colors"
          style={`color: var(--color-accent-blue)`}
        >
          <span data-scramble>All projects</span> &rarr;
        </a>
      </div>
    </div>

    <!-- Marquee container (full-width) -->
    <div class="relative">
      <!-- Fade edges -->
      <div class="absolute left-0 top-0 bottom-0 w-16 z-10 pointer-events-none" style="background: linear-gradient(to right, var(--color-bg), transparent)"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 z-10 pointer-events-none" style="background: linear-gradient(to left, var(--color-bg), transparent)"></div>

      <div class="marquee-track flex gap-6">
        {/* Render shuffled items twice for seamless loop */}
        {[...shuffled, ...shuffled].map((item) => (
          <div class="shrink-0 w-[350px] h-[330px]">
            <ProjectCard
              title={item.title}
              description={item.description}
              skillTags={item.skillTags}
              year={item.year}
              type={item.type}
              link={item.link}
              demo={item.demo}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick stats / terminal block -->
  <section class="py-16 border-t" style={`border-color: var(--color-border)`}>
    <div class="max-w-6xl mx-auto px-6">
      <!--
        Narrow screens stack each stat (label above an indented value) instead of
        using the 14ch label column, which left too few characters for the value
        and made wrapped lines fall back to the left margin. The hostname also
        drops its "-terminal" suffix below sm: so the prompt never breaks mid-word.
      -->
      <div
        class="rounded-lg border p-4 sm:p-6 font-mono text-xs sm:text-sm leading-relaxed"
        style={`background: var(--color-surface); border-color: var(--color-border)`}
      >
        <div class="mb-4" style={`color: var(--color-text-secondary)`}>
          <span style={`color: var(--color-border)`}>┌─[</span><span style="color: #22C55E">calvin@web<span class="hidden sm:inline">-terminal</span></span><span style={`color: var(--color-border)`}>]─[</span><span style={`color: var(--color-accent-blue)`}>~</span><span style={`color: var(--color-border)`}>]</span>
        </div>
        <div style={`color: var(--color-text-secondary)`}>
          <div>
            <span style={`color: var(--color-border)`}>└──╼</span> <span style={`color: var(--color-accent-blue)`}>$</span> cat stats.txt
          </div>

          <div class="my-4 space-y-1 sm:space-y-0">
            {terminalStats.map(({ label, value }) => (
              <div class="flex flex-col sm:flex-row">
                <span class="sm:w-[14ch] sm:shrink-0" style={`color: var(--color-text)`}>{label}</span>
                <span class="pl-[2ch] sm:pl-0 sm:flex-1 sm:min-w-0">{value}</span>
              </div>
            ))}
          </div>

          <div>
            <span style={`color: var(--color-border)`}>┌─[</span><span style="color: #22C55E">calvin@web<span class="hidden sm:inline">-terminal</span></span><span style={`color: var(--color-border)`}>]─[</span><span style={`color: var(--color-accent-blue)`}>~</span><span style={`color: var(--color-border)`}>]</span>
          </div>
          <div>
            <span style={`color: var(--color-border)`}>└──╼</span> <span style={`color: var(--color-accent-blue)`}>$</span> <a href="/about" class="transition-colors hover:underline" style={`color: var(--color-accent-blue)`}>more about me</a> <span class="cursor-blink"></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initGridGlow() {
    const hero = document.getElementById('hero-section');
    const glow = document.getElementById('grid-glow');
    if (!hero || !glow) return;

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      glow.style.setProperty('--mouse-x', `${x}px`);
      glow.style.setProperty('--mouse-y', `${y}px`);
    });

    hero.addEventListener('mouseleave', () => {
      glow.style.setProperty('--mouse-x', '-1000px');
      glow.style.setProperty('--mouse-y', '-1000px');
    });
  }

  initGridGlow();
  document.addEventListener('astro:after-swap', initGridGlow);
</script>
