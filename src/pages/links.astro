---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import calvinImg from '../assets/calvin_stahoviak.jpg';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/calvin-stahoviak/' },
  { label: 'GitHub', href: 'https://github.com/cjstahoviak' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=0ELvLnwAAAAJ&hl=en' },
  { label: 'Instagram', href: 'https://www.instagram.com/calvinnjames/' },
  { label: 'Goodreads', href: 'https://www.goodreads.com/user/show/196701152-calvin' },
  { label: 'Letterboxd', href: 'https://letterboxd.com/cjstahoviak/' },
  { label: 'MyAnimeList', href: 'https://myanimelist.net/profile/goToBedCalvin' },
  { label: 'Strava', href: 'https://www.strava.com/athletes/198820895' },
  { label: 'Vivino', href: 'https://www.vivino.com/users/calvin.stahoviak' },
];
---

<BaseLayout title="Links — Calvin Stahoviak" description="Find Calvin Stahoviak across the web.">
  <section class="relative min-h-screen flex items-center justify-center px-6 py-28 overflow-hidden">
    <!-- Grid background (drifts) -->
    <div class="absolute inset-0 grid-overlay pointer-events-none"></div>

    <!-- Blue radial glow at top -->
    <div
      class="absolute left-1/2 -translate-x-1/2 pointer-events-none"
      style="width: 900px; height: 650px; top: -200px; background: radial-gradient(ellipse at center, rgba(0,102,255,0.15), transparent 70%); z-index: 0"
    ></div>

    <div class="w-full max-w-md flex flex-col items-center gap-8 relative z-10">
      <!-- Headshot -->
      <Image
        src={calvinImg}
        alt="Calvin Stahoviak"
        width={96}
        height={96}
        loading="eager"
        class="w-24 h-24 rounded-full object-cover border-2"
        style={`border-color: var(--color-border)`}
      />

      <!-- Heading -->
      <h1 class="text-2xl md:text-3xl font-mono font-bold tracking-tight text-center">
        Hi, I'm <span class="text-gradient" id="calvin-scramble" data-scramble>Calvin</span>
      </h1>

      <p class="text-base leading-relaxed" style={`color: var(--color-text-secondary)`}>
        (My "Link Tree")
      </p>

      <!-- Link cells -->
      <div class="w-full flex flex-col gap-3">
        {links.map(({ label, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block w-full rounded-lg border p-4 font-mono text-sm text-center transition-all duration-300 hover:-translate-y-1"
            style={`background: var(--color-surface); border-color: var(--color-border); color: var(--color-text)`}
          >
            <span data-scramble data-scramble-trigger="parent">{label}</span>
            <div
              class="absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
              style={`background: var(--color-accent-blue)`}
            ></div>
            <div
              class="accent-bar-1 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
              style={`background: var(--color-accent-coral); z-index: 1`}
            ></div>
            <div
              class="accent-bar-2 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
              style="background: #22C55E; z-index: 2"
            ></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initCalvinScramble() {
    const el = document.getElementById('calvin-scramble') as HTMLElement | null;
    if (!el) return;

    const original = 'Calvin';
    const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    const duration = 500;
    const len = original.length;
    const resolveDelay = duration / len;

    function scramble(node: HTMLElement) {
      const startTime = performance.now();
      function tick() {
        const elapsed = performance.now() - startTime;
        const resolvedCount = Math.min(len, Math.floor(elapsed / resolveDelay));
        let result = '';
        for (let i = 0; i < len; i++) {
          result += i < resolvedCount ? original[i] : CHARS[Math.floor(Math.random() * CHARS.length)];
        }

        if (resolvedCount < len) {
          node.textContent = '';
          node.appendChild(document.createTextNode(result.slice(0, resolvedCount)));
          const cursor = document.createElement('span');
          cursor.className = 'scramble-cursor';
          cursor.textContent = result[resolvedCount] || '';
          node.appendChild(cursor);
          if (resolvedCount + 1 < len) {
            node.appendChild(document.createTextNode(result.slice(resolvedCount + 1)));
          }
          requestAnimationFrame(tick);
        } else {
          node.textContent = original;
        }
      }
      requestAnimationFrame(tick);
    }

    scramble(el);
    setInterval(() => scramble(el), 5000);
  }

  initCalvinScramble();
  document.addEventListener('astro:after-swap', initCalvinScramble);
</script>
