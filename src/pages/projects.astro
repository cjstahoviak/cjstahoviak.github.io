---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects — Calvin Stahoviak" description="Research and engineering projects by Calvin Stahoviak.">
  <section class="max-w-6xl mx-auto px-6 pt-28 pb-20">
    <!-- Page header -->
    <div class="mb-16">
      <h1 class="text-4xl md:text-5xl font-mono font-bold tracking-tight mb-4" style={`color: var(--color-text)`}>
        Projects
      </h1>
      <p class="text-base max-w-xl" style={`color: var(--color-text-secondary)`}>
        A selection of research and engineering work spanning robotics, machine learning, computer vision, and software development.
      </p>
      <div class="h-1 w-16 rounded mt-4" style={`background: var(--color-accent-blue)`}></div>
    </div>

    <!-- Projects grid (data lives in src/data/projects.ts) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          year={project.year}
          link={project.github}
          demo={project.demo}
          type="project"
        />
      ))}
    </div>
  </section>
</BaseLayout>
