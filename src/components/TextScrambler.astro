---
// TextScrambler — import once in BaseLayout.
// Any element with data-scramble gets a crypto-decode hover effect.
// If data-scramble-trigger="parent" is set, the effect triggers on the parent's hover instead.
// Duration scales with text length: Math.max(500, len * 15).
// Override with data-scramble-duration="1000" for custom timing.
//
// The scramble charset is chosen from the text itself: Japanese text scrambles
// through katakana, everything else through Latin. Substituting narrow Latin
// glyphs for full-width CJK ones (or the reverse) changes the element's width on
// every animation frame, which reads as layout thrash — matching the script
// keeps the width stable. Force a charset with data-scramble-charset="latin|katakana".
---

<script>
  const CHARSETS: Record<string, string> = {
    latin: 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789',
    katakana: 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワン',
  };

  // Hiragana, katakana, and CJK ideographs.
  const CJK = /[぀-ヿ㐀-䶿一-鿿豈-﫿]/;

  // Left in place rather than scrambled, so the text keeps its silhouette.
  // Japanese has no inter-word spaces, so its brackets and punctuation do that job.
  const PRESERVE = new Set([...' 　「」（）()・、。／/—–-']);

  const MS_PER_CHAR = 15;
  const MIN_DURATION = 500;

  interface ScramblerState {
    original: string;
    running: boolean;
    frame: number;
    duration: number;
    chars: string;
  }

  const state = new WeakMap<Element, ScramblerState>();

  function getDuration(el: Element, len: number): number {
    const override = el.getAttribute('data-scramble-duration');
    if (override) return parseInt(override, 10);
    return Math.max(MIN_DURATION, len * MS_PER_CHAR);
  }

  function getCharset(el: Element, text: string): string {
    const override = el.getAttribute('data-scramble-charset');
    if (override && CHARSETS[override]) return CHARSETS[override];
    return CJK.test(text) ? CHARSETS.katakana : CHARSETS.latin;
  }

  function scramble(el: Element) {
    const s = state.get(el);
    if (!s || s.running) return;
    s.running = true;

    const len = s.original.length;
    const resolveDelay = s.duration / len;
    const startTime = performance.now();

    function tick() {
      const elapsed = performance.now() - startTime;
      const resolvedCount = Math.min(len, Math.floor(elapsed / resolveDelay));
      let result = '';

      for (let i = 0; i < len; i++) {
        if (PRESERVE.has(s.original[i])) {
          result += s.original[i];
        } else if (i < resolvedCount) {
          result += s.original[i];
        } else {
          result += s.chars[Math.floor(Math.random() * s.chars.length)];
        }
      }

      if (resolvedCount < len) {
        // Build DOM: text before cursor, cursor block, text after cursor
        el.textContent = '';
        el.appendChild(document.createTextNode(result.slice(0, resolvedCount)));
        const cursor = document.createElement('span');
        cursor.className = 'scramble-cursor';
        cursor.textContent = result[resolvedCount] || '';
        el.appendChild(cursor);
        if (resolvedCount + 1 < len) {
          el.appendChild(document.createTextNode(result.slice(resolvedCount + 1)));
        }
        s.frame = requestAnimationFrame(tick);
      } else {
        el.textContent = s.original;
        s.running = false;
      }
    }

    s.frame = requestAnimationFrame(tick);
  }

  function init() {
    document.querySelectorAll('[data-scramble]').forEach((el) => {
      if (state.has(el)) return;

      const original = el.textContent || '';
      state.set(el, {
        original,
        running: false,
        frame: 0,
        duration: getDuration(el, original.length),
        chars: getCharset(el, original),
      });

      const trigger = el.getAttribute('data-scramble-trigger');

      if (trigger === 'parent' && el.parentElement) {
        const card = el.closest('.group') || el.parentElement;
        card.addEventListener('mouseenter', () => scramble(el));
      } else {
        el.addEventListener('mouseenter', () => scramble(el));
      }
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
