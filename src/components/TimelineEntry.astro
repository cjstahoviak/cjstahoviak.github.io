---
interface Props {
  title: string;
  subtitle: string;
  date: string;
  location: string;
  items?: string[];
  accent?: string;
}

const { title, subtitle, date, location, items, accent = 'var(--color-accent-blue)' } = Astro.props;
---

<div class="relative pl-8 pb-10 group">
  <!-- Timeline line -->
  <div
    class="absolute left-[9px] top-3 bottom-0 w-px"
    style={`background: var(--color-border)`}
  ></div>

  <!-- Timeline dot -->
  <div
    class="absolute left-0 top-2 w-[18px] h-[18px] rounded-full border-2 transition-colors"
    style={`border-color: ${accent}; background: var(--color-bg)`}
  >
    <div
      class="absolute inset-[3px] rounded-full timeline-dot-fill scale-50 opacity-0 group-hover:scale-100 group-hover:opacity-100"
      style={`background: ${accent}`}
    ></div>
  </div>

  <!-- Content -->
  <div>
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
      <h3 class="font-mono font-bold text-base" style={`color: var(--color-text)`}>
        {title}
      </h3>
      <span class="font-mono text-xs shrink-0" style={`color: ${accent}`}>
        {date}
      </span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 mb-3">
      <span class="text-sm italic" style={`color: var(--color-text-secondary)`}>{subtitle}</span>
      <span class="hidden sm:inline" style={`color: var(--color-border)`}>&middot;</span>
      <span class="font-mono text-xs" style={`color: var(--color-text-secondary)`}>{location}</span>
    </div>
    {items && items.length > 0 && (
      <ul class="space-y-1.5">
        {items.map((item) => (
          <li class="text-sm leading-relaxed flex gap-2" style={`color: var(--color-text-secondary)`}>
            <span class="shrink-0 mt-1.5 w-1 h-1 rounded-full" style={`background: var(--color-border)`}></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
