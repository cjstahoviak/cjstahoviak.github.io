---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/publications', label: 'Publications' },
  { href: '/blog', label: 'Blog' },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b"
  style={`background: color-mix(in srgb, var(--color-bg) 80%, transparent); border-color: var(--color-border)`}
  id="main-nav"
>
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo with expanding blue dot → gradient -->
    <a href="/" class="nav-logo relative font-mono font-bold text-xl tracking-tight flex items-center gap-4 pl-7 pr-2 py-1 rounded-md" aria-label="Home">
      <span
        class="nav-logo-dot absolute rounded-sm transition-all duration-300 ease-in-out"
        style={`background: var(--color-accent-blue); width: 14px; height: 14px; left: 0; top: 50%; transform: translateY(-50%); z-index: 0`}
      ></span>
      <span class="nav-logo-text relative z-10 transition-colors duration-300" style={`color: var(--color-text)`}>CS</span>
      <span class="nav-logo-text relative z-10 font-normal transition-colors duration-300" style={`color: var(--color-text-secondary)`}>//</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      {links.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'px-4 py-2 font-mono text-base rounded-md transition-colors',
              isActive ? 'nav-link-active' : 'nav-link',
            ]}
            style={isActive
              ? `color: var(--color-accent-blue); background: color-mix(in srgb, var(--color-accent-blue) 10%, transparent)`
              : `color: var(--color-text-secondary)`}
          >
            <span data-scramble>{label}</span>
          </a>
        );
      })}
      <div class="ml-4 pl-4 flex items-center gap-3" style={`border-left: 1px solid var(--color-border)`}>
        <!-- Archive dropdown -->
        <div class="relative" id="archive-dropdown">
          <button
            class="flex items-center gap-1 px-4 py-2 font-mono text-base rounded-md transition-colors"
            style={`color: var(--color-text-secondary)`}
            id="archive-btn"
            aria-expanded="false"
          >
            <span data-scramble>Archive</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200" id="archive-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            class="hidden absolute top-full right-0 mt-1 rounded-md border py-1 min-w-[120px] z-50"
            style={`background: var(--color-surface); border-color: var(--color-border)`}
            id="archive-menu"
          >
            <a
              href="/archive/2025/index.html"
              class="block px-4 py-2 font-mono text-xs transition-colors hover:bg-[var(--color-elevated)]"
              style={`color: var(--color-text-secondary)`}
            >
              <span data-scramble>2025</span>
            </a>
          </div>
        </div>
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile menu button -->
    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="p-2 rounded-md transition-colors"
        style={`color: var(--color-text-secondary)`}
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-5 h-5 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t"
    style={`background: var(--color-bg); border-color: var(--color-border)`}
  >
    <div class="px-6 py-4 flex flex-col gap-1">
      {links.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class="px-3 py-2 font-mono text-sm rounded-md transition-colors"
            style={isActive
              ? `color: var(--color-accent-blue); background: color-mix(in srgb, var(--color-accent-blue) 10%, transparent)`
              : `color: var(--color-text-secondary)`}
          >
            {label}
          </a>
        );
      })}
      <div class="border-t mt-2 pt-2" style={`border-color: var(--color-border)`}>
        <span class="px-3 py-1 font-mono text-xs uppercase tracking-wider block" style={`color: var(--color-text-secondary)`}>Archive</span>
        <a
          href="/archive/2025/index.html"
          class="px-3 py-2 font-mono text-sm rounded-md transition-colors block"
          style={`color: var(--color-text-secondary)`}
        >
          2025
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Archive dropdown toggle
  function initArchiveDropdown() {
    const btn = document.getElementById('archive-btn');
    const menu = document.getElementById('archive-menu');
    const chevron = document.getElementById('archive-chevron');
    if (!btn || !menu || !chevron) return;

    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
      btn.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('#archive-dropdown')) {
        menu.classList.add('hidden');
        chevron.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initArchiveDropdown();
  document.addEventListener('astro:after-swap', initArchiveDropdown);

  // Logo hover: expand blue dot to full gradient, shrink back on leave
  function initLogoHover() {
    const logo = document.querySelector('.nav-logo') as HTMLElement | null;
    const dot = document.querySelector('.nav-logo-dot') as HTMLElement | null;
    const textSpans = logo?.querySelectorAll<HTMLElement>('.nav-logo-text');

    if (!logo || !dot) return;

    logo.addEventListener('mouseenter', () => {
      dot.style.width = '100%';
      dot.style.height = '100%';
      dot.style.left = '0';
      dot.style.top = '0';
      dot.style.transform = 'none';
      dot.style.borderRadius = '6px';
      dot.style.background = 'linear-gradient(135deg, var(--color-accent-blue), var(--color-accent-coral))';
      textSpans?.forEach((span) => { span.style.color = 'white'; });
    });

    logo.addEventListener('mouseleave', () => {
      dot.style.width = '14px';
      dot.style.height = '14px';
      dot.style.left = '0';
      dot.style.top = '50%';
      dot.style.transform = 'translateY(-50%)';
      dot.style.borderRadius = '';
      dot.style.background = 'var(--color-accent-blue)';
      textSpans?.forEach((span) => { span.style.color = ''; });
    });
  }

  initLogoHover();
  document.addEventListener('astro:after-swap', initLogoHover);
</script>
