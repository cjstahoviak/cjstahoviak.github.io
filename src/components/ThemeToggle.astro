---
---

<button
  class="theme-toggle px-4 py-2 rounded-md transition-colors active-press"
  style={`color: var(--color-text-secondary)`}
  aria-label="Toggle dark/light mode"
  type="button"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="w-5 h-5 theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="w-5 h-5 theme-icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<style is:global>
  /* Theme-change wipe: a full-viewport panel that travels bottom → top in one
     weighted motion (same curve as the load splash), covering the page at the
     midpoint where the theme actually flips. Created dynamically, so this
     lives in a global style block. */
  .theme-wipe {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    border-top: 10px solid #0a0a0a;
    border-bottom: 10px solid #0a0a0a;
    transform: translateY(101%);
    animation: themeWipe 1.2s cubic-bezier(0.87, 0, 0.13, 1) forwards;
  }

  @keyframes themeWipe {
    from {
      transform: translateY(101%);
    }
    to {
      transform: translateY(-101%);
    }
  }
</style>

<script>
  function initThemeToggle() {
    const toggles = document.querySelectorAll('.theme-toggle');
    const sunIcons = document.querySelectorAll('.theme-icon-sun');
    const moonIcons = document.querySelectorAll('.theme-icon-moon');
    const WIPE_MS = 1200;
    let wiping = false;

    function updateIcons() {
      const isLight = document.documentElement.classList.contains('light');
      sunIcons.forEach(icon => icon.classList.toggle('hidden', isLight));
      moonIcons.forEach(icon => icon.classList.toggle('hidden', !isLight));
    }

    function setTheme(toLight: boolean) {
      document.documentElement.classList.toggle('light', toLight);
      document.documentElement.classList.toggle('dark', !toLight);
      localStorage.setItem('theme', toLight ? 'light' : 'dark');
      updateIcons();
    }

    updateIcons();

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        if (wiping) return;
        const toLight = !document.documentElement.classList.contains('light');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          setTheme(toLight);
          return;
        }

        wiping = true;
        const panel = document.createElement('div');
        panel.className = 'theme-wipe';
        // White wipe reveals light mode, accent-blue wipe reveals dark mode
        panel.style.background = toLight ? '#F5F5F0' : '#0066FF';
        document.body.appendChild(panel);

        // Flip the theme at the midpoint, while the page is fully covered
        setTimeout(() => setTheme(toLight), WIPE_MS / 2);

        function cleanup() {
          panel.remove();
          wiping = false;
        }
        panel.addEventListener('animationend', cleanup);
        // Safety net in case the animation never fires
        setTimeout(cleanup, WIPE_MS + 1000);
      });
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
