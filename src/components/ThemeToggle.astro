---
---

<button
  class="theme-toggle px-4 py-2 rounded-md transition-colors active-press"
  style={`color: var(--color-text-secondary)`}
  aria-label="Toggle dark/light mode"
  type="button"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="w-5 h-5 theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="w-5 h-5 theme-icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<style is:global>
  /* Theme-change wipe: replays the load splash on toggle. A panel rises
     bottom → top with the splash's weighted curve, pauses covering the page
     while "$ hello" types out (the theme flips here, hidden), then rolls up
     and off to reveal the new colorway. Created dynamically, so this lives in
     a global style block. The 'Splash Pixel' font-face is provided by
     SplashScreen.astro, which is on every page. */
  .theme-wipe {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    border-top: 10px solid #0a0a0a;
    border-bottom: 10px solid #0a0a0a;
    transform: translateY(101%);
  }

  .theme-wipe.theme-wipe-enter {
    animation: themeWipeEnter 0.75s cubic-bezier(0.87, 0, 0.13, 1) forwards;
  }

  .theme-wipe.theme-wipe-exit {
    animation: themeWipeExit 0.9s cubic-bezier(0.87, 0, 0.13, 1) forwards;
  }

  @keyframes themeWipeEnter {
    from {
      transform: translateY(101%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes themeWipeExit {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-101%);
    }
  }

  .theme-wipe-line {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: 'Splash Pixel', var(--font-mono);
    font-size: clamp(1.75rem, 6vw, 4rem);
    color: #0a0a0a;
    line-height: 1;
  }

  .theme-wipe-prompt {
    opacity: 0.55;
  }

  .theme-wipe-cursor {
    display: inline-block;
    width: 0.85em;
    height: 1em;
    margin-left: 0.15em;
    background: #0a0a0a;
    transform: translateY(0.12em);
  }

  .theme-wipe-cursor.theme-wipe-blink {
    animation: themeWipeBlink 1s step-end infinite;
  }

  @keyframes themeWipeBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  function initThemeToggle() {
    const toggles = document.querySelectorAll('.theme-toggle');
    const sunIcons = document.querySelectorAll('.theme-icon-sun');
    const moonIcons = document.querySelectorAll('.theme-icon-moon');
    let wiping = false;

    function updateIcons() {
      const isLight = document.documentElement.classList.contains('light');
      sunIcons.forEach(icon => icon.classList.toggle('hidden', isLight));
      moonIcons.forEach(icon => icon.classList.toggle('hidden', !isLight));
    }

    function setTheme(toLight: boolean) {
      document.documentElement.classList.toggle('light', toLight);
      document.documentElement.classList.toggle('dark', !toLight);
      localStorage.setItem('theme', toLight ? 'light' : 'dark');
      updateIcons();
    }

    updateIcons();

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        if (wiping) return;
        const toLight = !document.documentElement.classList.contains('light');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          setTheme(toLight);
          return;
        }

        wiping = true;
        const panel = document.createElement('div');
        panel.className = 'theme-wipe theme-wipe-enter';
        // White wipe reveals light mode, accent-blue wipe reveals dark mode
        panel.style.background = toLight ? '#F5F5F0' : '#0066FF';
        panel.innerHTML =
          '<p class="theme-wipe-line">' +
          '<span class="theme-wipe-prompt">$</span>' +
          '<span class="theme-wipe-text"></span>' +
          '<span class="theme-wipe-cursor"></span>' +
          '</p>';
        document.body.appendChild(panel);

        const textEl = panel.querySelector('.theme-wipe-text')!;
        const cursorEl = panel.querySelector('.theme-wipe-cursor')!;
        const message = 'hello';
        let applied = false;

        function apply() {
          if (applied) return;
          applied = true;
          setTheme(toLight);
        }

        function cleanup() {
          apply();
          panel.remove();
          wiping = false;
        }

        panel.addEventListener('animationend', (e) => {
          if (e.animationName === 'themeWipeEnter') {
            // Paused, page fully covered: flip the theme, type the message,
            // blink for a beat, then roll up and off
            apply();
            let i = 1;
            (function type() {
              if (!panel.isConnected) return;
              textEl.textContent = message.slice(0, i);
              if (i < message.length) {
                i++;
                setTimeout(type, 70);
              } else {
                cursorEl.classList.add('theme-wipe-blink');
                setTimeout(() => {
                  panel.classList.remove('theme-wipe-enter');
                  panel.classList.add('theme-wipe-exit');
                }, 700);
              }
            })();
          } else if (e.animationName === 'themeWipeExit') {
            cleanup();
          }
        });

        // Safety net in case an animation event never fires
        setTimeout(cleanup, 6000);
      });
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
