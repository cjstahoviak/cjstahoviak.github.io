---
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
  /** 1-based citation number, rendered as [n]. */
  index: number;
}

const { publication: pub, index } = Astro.props;

const isMe = pub.leadAuthor.startsWith('Stahoviak');
const statusLabel = pub.status === 'accepted' ? 'Accepted' : 'Published';

// The card itself is deliberately not a link — only the "view page" text at the
// bottom navigates, so the pointer cursor appears only over that.
---

<article class="group relative rounded-lg border p-6 transition-transform duration-300 ease-out-expo hover:-translate-y-1" style={`background: var(--color-surface); border-color: var(--color-border)`}>
  <div class="flex items-center gap-3 mb-3">
    <span class="font-mono text-xs font-bold px-2 py-0.5 rounded" style={`background: color-mix(in srgb, var(--color-accent-blue) 15%, transparent); color: var(--color-accent-blue)`}>
      [{index}]
    </span>
    {pub.status === 'accepted' ? (
      <span class="font-mono text-xs px-2 py-0.5 rounded" style={`background: color-mix(in srgb, var(--color-accent-yellow) 15%, transparent); color: var(--color-accent-yellow-ink)`}>
        {statusLabel}
      </span>
    ) : (
      <span class="font-mono text-xs px-2 py-0.5 rounded" style={`background: color-mix(in srgb, #22C55E 15%, transparent); color: var(--color-green-ink)`}>
        {statusLabel}
      </span>
    )}
    <span class="ml-auto font-mono text-xs tracking-wider" style={`color: var(--color-text-secondary)`}>
      {pub.year}
    </span>
  </div>
  <h3 class="font-mono font-bold text-base mb-2" style={`color: var(--color-text)`} data-scramble data-scramble-trigger="parent">
    {pub.title}
  </h3>
  <p class="text-sm mb-3" style={`color: var(--color-text-secondary)`}>
    {isMe ? <strong style="color: var(--color-author-ink)">{pub.leadAuthor}</strong> : pub.leadAuthor} et al.
  </p>
  <p class="font-mono text-xs" style={`color: var(--color-text-secondary)`}>
    <em>{pub.venue}</em>, {pub.year}.
  </p>
  {pub.link && (
    <a
      href={pub.link}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-4 font-mono text-sm underline underline-offset-2 transition-opacity hover:opacity-70 active-press"
      style={`color: var(--color-accent-blue)`}
      data-scramble
    >view page</a>
  )}
  <div
    class="absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style={`background: var(--color-accent-blue)`}
  ></div>
  <div
    class="accent-bar-1 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style={`background: var(--color-accent-coral); z-index: 1`}
  ></div>
  <div
    class="accent-bar-2 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style="background: #22C55E; z-index: 2"
  ></div>
</article>
