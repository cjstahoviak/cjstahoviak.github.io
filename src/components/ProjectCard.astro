---
interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string;
  demo?: string;
  type?: 'project' | 'publication';
}

const { title, description, tags, github, demo, type } = Astro.props;
---

<div
  class="group relative rounded-lg border p-6 transition-all duration-300 hover:-translate-y-1 h-full flex flex-col"
  style={`background: var(--color-surface); border-color: var(--color-border)`}
>
  <!-- Type indicator -->
  {type && (
    <div class="flex items-center gap-2 mb-3">
      <span
        class="inline-block w-2 h-2 rounded-full"
        style={type === 'project'
          ? 'background: var(--color-accent-blue)'
          : 'background: var(--color-accent-coral)'}
      ></span>
      <span class="font-mono text-xs uppercase tracking-wider" style={`color: var(--color-text-secondary)`}>
        {type}
      </span>
    </div>
  )}

  <!-- Title -->
  <h3 class="font-mono text-lg font-bold mb-2 tracking-tight" style={`color: var(--color-text)`} data-scramble data-scramble-trigger="parent">
    {title}
  </h3>

  <!-- Description -->
  <p class="text-sm leading-relaxed mb-4 flex-1" style={`color: var(--color-text-secondary)`}>
    {description}
  </p>

  <!-- Tags -->
  <div class="flex flex-wrap gap-2 mb-4">
    {tags.map((tag) => (
      <span
        class="px-2 py-1 font-mono text-xs rounded"
        style={`background: var(--color-elevated); border: 1px solid var(--color-border); color: var(--color-text-secondary)`}
      >
        {tag}
      </span>
    ))}
  </div>

  <!-- Links -->
  {(github || demo) && (
    <div class="flex gap-3">
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
          style={`color: var(--color-accent-blue)`}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          Source
        </a>
      )}
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
          style={`color: var(--color-accent-coral)`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Demo
        </a>
      )}
    </div>
  )}

  <!-- Hover accent lines: blue → coral → green -->
  <div
    class="absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style={`background: var(--color-accent-blue)`}
  ></div>
  <div
    class="accent-bar-1 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style={`background: var(--color-accent-coral); z-index: 1`}
  ></div>
  <div
    class="accent-bar-2 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style="background: #22C55E; z-index: 2"
  ></div>
</div>
