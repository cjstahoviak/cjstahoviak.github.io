---
interface Props {
  title: string;
  description: string;
  /** Skills demonstrated by the work. Omit to render the card without a tag row. */
  skillTags?: string[];
  github?: string;
  demo?: string;
  type?: 'project' | 'publication';
}

const { title, description, skillTags, github, demo, type } = Astro.props;
---

<div
  class="group relative rounded-lg border p-6 transition-transform duration-300 ease-out-expo active-press hover:-translate-y-1 h-full flex flex-col overflow-hidden"
  style={`background: var(--color-surface); border-color: var(--color-border)`}
>
  <!-- Type indicator -->
  {type && (
    <div class="flex items-center gap-2 mb-3">
      <span
        class="inline-block w-2 h-2 rounded-full"
        style={type === 'project'
          ? 'background: var(--color-accent-blue)'
          : 'background: var(--color-accent-coral)'}
      ></span>
      <span class="font-mono text-xs uppercase tracking-wider" style={`color: var(--color-text-secondary)`}>
        {type}
      </span>
    </div>
  )}

  <!-- Title -->
  <h3 class="font-mono text-lg font-bold mb-2 tracking-tight" style={`color: var(--color-text)`} data-scramble data-scramble-trigger="parent">
    {title}
  </h3>

  <!-- Description (min-h-0 lets it shrink inside fixed-height carousel cards so tags stay inside the card) -->
  <p class="text-sm leading-relaxed mb-4 flex-1 min-h-0 overflow-hidden" style={`color: var(--color-text-secondary)`}>
    {description}
  </p>

  <!-- Skill tags (footnote-sized, smaller than the rest of the card) -->
  {skillTags && skillTags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-4">
      {skillTags.map((tag) => (
        <span
          class="px-1.5 py-0.5 font-mono text-[10px] leading-relaxed rounded"
          style={`background: var(--color-elevated); border: 1px solid var(--color-border); color: var(--color-text-secondary)`}
        >
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- See more link -->
  {(github || demo) && (
    <div class="flex gap-4">
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm underline underline-offset-2 transition-colors"
          style={`color: var(--color-accent-blue)`}
        >
          see more
        </a>
      )}
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm underline underline-offset-2 transition-colors"
          style={`color: var(--color-accent-blue)`}
        >
          demo
        </a>
      )}
    </div>
  )}

  <!-- Hover accent lines: blue → coral → green -->
  <div
    class="absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style={`background: var(--color-accent-blue)`}
  ></div>
  <div
    class="accent-bar-1 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style={`background: var(--color-accent-coral); z-index: 1`}
  ></div>
  <div
    class="accent-bar-2 absolute bottom-0 left-0 right-0 h-0.5 rounded-b-lg transition-transform duration-300 origin-left scale-x-0 group-hover:scale-x-100"
    style="background: #22C55E; z-index: 2"
  ></div>
</div>
