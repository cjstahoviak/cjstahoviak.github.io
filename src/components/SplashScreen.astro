---
// Terminal boot splash: a full-viewport accent-blue screen that types "hello"
// with a black block cursor, then slides up to reveal the page. Plays once per
// browser session; skipped entirely for reduced-motion users and no-JS visitors.
---

<div id="splash" aria-hidden="true">
  <p class="splash-line">
    <span class="splash-prompt">$</span>
    <span id="splash-text"></span><span id="splash-cursor"></span>
  </p>
</div>

<noscript>
  <style>
    #splash {
      display: none;
    }
  </style>
</noscript>

<style>
  /* Press Start 2P subset (a-z, 0-9, $ > _ . space), inlined so the splash
     renders blocky on first paint with no network request or font swap. */
  @font-face {
    font-family: 'Splash Pixel';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url(data:font/woff2;base64,) format('woff2');
  }

  #splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-blue);
    border-bottom: 10px solid #0a0a0a;
    cursor: pointer;
  }

  #splash.splash-exit {
    animation: splashExit 0.9s cubic-bezier(0.87, 0, 0.13, 1) forwards;
  }

  @keyframes splashExit {
    to {
      transform: translateY(-100.5%);
    }
  }

  .splash-line {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: 'Splash Pixel', var(--font-mono);
    font-size: clamp(1.75rem, 6vw, 4rem);
    color: #0a0a0a;
    line-height: 1;
  }

  .splash-prompt {
    opacity: 0.55;
  }

  #splash-cursor {
    display: inline-block;
    width: 0.85em;
    height: 1em;
    margin-left: 0.15em;
    background: #0a0a0a;
    transform: translateY(0.12em);
  }

  #splash-cursor.splash-cursor-blink {
    animation: splashBlink 1s step-end infinite;
  }

  @keyframes splashBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #splash {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var splash = document.getElementById('splash');
    if (!splash) return;

    var seen = false;
    try {
      seen = sessionStorage.getItem('splash-seen') === '1';
    } catch (e) {}

    if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      splash.remove();
      return;
    }

    try {
      sessionStorage.setItem('splash-seen', '1');
    } catch (e) {}

    document.documentElement.style.overflow = 'hidden';

    var textEl = document.getElementById('splash-text');
    var cursorEl = document.getElementById('splash-cursor');
    var message = 'hello';
    var exiting = false;

    function finish() {
      if (exiting) return;
      exiting = true;
      splash.classList.add('splash-exit');
    }

    function cleanup() {
      document.documentElement.style.overflow = '';
      splash.remove();
    }

    splash.addEventListener('animationend', cleanup);
    splash.addEventListener('click', finish);
    // Safety net: never leave the page trapped behind the splash
    setTimeout(cleanup, 6000);

    var i = 1;
    function type() {
      if (exiting) return;
      textEl.textContent = message.slice(0, i);
      if (i < message.length) {
        i++;
        setTimeout(type, 85);
      } else {
        cursorEl.classList.add('splash-cursor-blink');
        setTimeout(finish, 1400);
      }
    }
    setTimeout(type, 400);
  })();
</script>
